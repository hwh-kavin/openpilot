#: ../pythonpath/openpilot/selfdrive/ui/sunnypilot/layouts/settings/steering.py
msgid "Ford Lateral Control Method"
msgstr "福特横向控制方式"

msgid "Curvature: 4-signal polynomial (c0/c1/c2/c3). Angle: path_angle derived from curvature."
msgstr "曲率：四信号多项式（c0/c1/c2/c3）。角度：由曲率换算 path_angle。"

msgid "Curvature"
msgstr "曲率"

msgid "Angle"
msgstr "角度"

msgid "Bypass BluePilot Lateral"
msgstr "旁路 BluePilot 横向"

msgid "Use the stock curvature-only steering path instead of BluePilot lateral strategies."
msgstr "使用原厂仅曲率转向路径，替代 BluePilot 横向策略。"

msgid "Steering-Angle Curvature Measurement"
msgstr "转向角曲率测量"

msgid "Measure curvature from the steering pinion angle instead of the RCM yaw rate (for a faulty yaw sensor)."
msgstr "从转向小齿轮角测量曲率，替代 RCM 横摆率（适用于横摆传感器故障车辆）。"

msgid "Angle: Low Speed Factor"
msgstr "角度：低速系数"

msgid "Angle: High Speed Factor"
msgstr "角度：高速系数"

msgid "Angle: High Speed Dampening"
msgstr "角度：高速阻尼"

msgid "Angle: Lane Change Factor"
msgstr "角度：变道系数"

msgid "Angle: Base Lateral Gain"
msgstr "角度：基础横向增益"

msgid "Angle: Deviation Clip"
msgstr "角度：偏差限幅"

msgid "Angle: Enable Lane Positioning"
msgstr "角度：启用车道定位"

msgid "Angle: In-Lane Offset"
msgstr "角度：车道内偏移"

msgid "Angle: Lane Centering Strength"
msgstr "角度：车道居中强度"

msgid "Scales the correction toward the center of trusted lane lines. Higher values apply a stronger correction; 0 disables it. Only active when Angle Lane Positioning is enabled, lateral control is active, and no lane change is in progress."
msgstr "调整向可信车道线中心修正的强度。数值越大，修正越强；设为 0 可关闭修正。仅在启用角度车道定位、横向控制有效且未处于变道过程中时生效。"

msgid "Curvature: Lane Change Factor"
msgstr "曲率：变道系数"

msgid "Curvature: Blend Ratio (Low Curvature)"
msgstr "曲率：混合比例（低曲率）"

msgid "Curvature: Blend Ratio (High Curvature)"
msgstr "曲率：混合比例（高曲率）"

msgid "Curvature: Lane Positioning (PID)"
msgstr "曲率：车道定位（PID）"

msgid "Curvature: Lane Full Mode"
msgstr "曲率：完整车道模式"

msgid "Curvature: Tuning Profile"
msgstr "曲率：调校配置"

msgid "Custom"
msgstr "自定义"

msgid "Curvature: Lane Centering PID Gain"
msgstr "曲率：车道居中 PID 增益"

#: ../pythonpath/openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise.py
msgid "Bypass BP Longitudinal Control"
msgstr "绕过 BluePilot 纵向控制"

msgid "Disable BluePilot's follow-aware longitudinal control (lead classification, gas/accel limits, brake/precharge hysteresis). Above ~50 mph with a lead it smooths following; disable to use stock openpilot longitudinal only."
msgstr "禁用 BluePilot 的跟车感知纵向控制（前车分类、油门/加速度限制、刹车/预充压迟滞）。约 50 mph 以上有前车时让跟车更平顺；禁用后仅使用 stock openpilot 纵向控制。"

msgid "Disable Downhill Compensation"
msgstr "禁用下坡补偿"

msgid "Ignore negative pitch compensation so downhill deceleration is not added."
msgstr "忽略负俯仰补偿，使下坡时不额外减速。"

msgid "When enabled, sunnypilot will attempt to manage the built-in cruise control buttons by emulating button presses for limited longitudinal control."
msgstr "启用后，sunnypilot 将尝试通过模拟按钮按压来管理内置巡航控制按键，以提供有限的纵向控制。"
